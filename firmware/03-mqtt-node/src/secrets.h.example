// Copy this file to src/secrets.h and fill in real values.
// src/secrets.h is git-ignored — never commit it, never paste it into chat.

#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

#define MQTT_HOST "192.168.68.106"  // T2-PC LAN IP (WSL mirrored networking)
#define MQTT_PORT 1883              // plain MQTT on LAN; TLS 8883 in Phase 8

// One MQTT account per board (created in Phase 2, step B3).
// The board is selected automatically by the build environment.
#if defined(BOARD_C6)
#define MQTT_USER "esp32c6"
#define MQTT_PASS "paste-esp32c6-password"
#elif defined(BOARD_C3)
#define MQTT_USER "esp32c3"
#define MQTT_PASS "paste-esp32c3-password"
#elif defined(BOARD_8266)
#define MQTT_USER "esp8266"
#define MQTT_PASS "paste-esp8266-password"
#else
#error "No board macro defined — check build_flags in platformio.ini"
#endif

// Device id used in topics: dev/<DEVICE_ID>/state, /event, /cmd, /status
#define DEVICE_ID MQTT_USER
