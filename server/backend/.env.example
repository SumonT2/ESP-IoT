# Copy to .env and fill in. .env is git-ignored — never commit it.

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASS=paste-backend-password-from-phase-2

# Bind to loopback only until Phase 6 (Cloudflare Access) adds a login gate.
# Windows can still reach it at http://localhost:8080 (WSL mirrored networking).
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

DB_PATH=./data/iot.db
LOG_LEVEL=info
